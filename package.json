{
  "name": "use-mqtt-hooks",
  "version": "0.2.0",
  "description": "React hooks for MQTT: a connection provider, reference-counted subscriptions, and retained-message state",
  "keywords": [
    "mqtt",
    "react",
    "react-hooks",
    "hooks",
    "iot",
    "mqtt-client",
    "websocket"
  ],
  "license": "MIT",
  "author": "Evan Broder <evan@ebroder.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebroder/use-mqtt-hooks.git"
  },
  "homepage": "https://github.com/ebroder/use-mqtt-hooks#readme",
  "bugs": "https://github.com/ebroder/use-mqtt-hooks/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint",
    "lint:prettier": "prettier --check .",
    "lint": "concurrently --timings -c auto npm:lint:*"
  },
  "dependencies": {
    "mqtt": "^5.14.1",
    "mqtt-pattern": "^2.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "execa": "^10.0.1",
    "get-port": "^7.2.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
